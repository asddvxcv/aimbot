-- Target acquisition logic
local function getSilentAimTarget()
    if not silentAimEnabled then return nil end

    local camera = workspace.CurrentCamera
    if not camera then return nil end

    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    local closest = nil
    local closestScreenDistance = silentAimFOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and acceptedPlayers[player] then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if humanoid and humanoid.Health > 5 and root and not deadPlayers[player] then
                local screen, onScreen = camera:WorldToViewportPoint(root.Position)

                if onScreen then
                    local distance = (
                        Vector2.new(screen.X, screen.Y) - center
                    ).Magnitude

                    if distance <= closestScreenDistance then
                        closestScreenDistance = distance
                        closest = player
                    end
                end
            end
        end
    end

    -- Return the actual physical Hitbox part (Head or HumanoidRootPart) instead of just the player instance
    return closest and closest.Character and closest.Character:FindFirstChild("Head")
end

-- HOOKMETAMETHOD ENGINE INTERCEPTION
-- We intercept Roblox's '__namecall' method. This maps directly to functions called like game:GetService("Players") or workspace:FindPartOnRay()
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if silentAimEnabled and not checkcaller() then
        -- Intercept standard Raycasting methods used by weapons
        if method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "findPartOnRayWithIgnoreList" then
            local targetPart = getSilentAimTarget()
            if targetPart then
                -- Override the origin and direction vector to point perfectly at the Target Head
                local camera = workspace.CurrentCamera
                local origin = camera.CFrame.Position
                local direction = (targetPart.Position - origin).Unit * 5000
                
                -- Construct a brand new Ray targeted at our intercepted player
                args[1] = Ray.new(origin, direction)
                return oldNamecall(self, table.unpack(args))
            end
            
        elseif method == "Raycast" then
            local targetPart = getSilentAimTarget()
            if targetPart then
                local camera = workspace.CurrentCamera
                local origin = args[1] -- Original position parameter
                local direction = (targetPart.Position - origin).Unit * 5000
                
                args[2] = direction -- Override direction
                return oldNamecall(self, table.unpack(args))
            end
        end
    end

    return oldNamecall(self, ...)
end)

