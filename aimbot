local function animateMinimizeIcon()

	local white =
		Color3.fromRGB(255, 255, 255)

	local rgb =
		Color3.fromHSV(
			math.random(),
			0.55,
			0.9
		)

	local fadeIn = TweenInfo.new(
		0.15,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	local fadeOut = TweenInfo.new(
		0.15,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	TweenService:Create(
		miniHorizontal,
		fadeIn,
		{
			BackgroundColor3 = rgb
		}
	):Play()

	TweenService:Create(
		miniVertical,
		fadeIn,
		{
