--------------------------------------------------
-- AUTOMATIC ACCEPTED-TARGET SELECTION
--------------------------------------------------

local function selectClosestAcceptedTarget()
	local closest = getClosestAcceptedTarget()
	if closest then setTarget(closest) end
end

local function selectNextAcceptedTarget()
	local list = getTargetList()
	if #list == 0 then setTarget(nil); return end
	local index = 0
	for i, player in ipairs(list) do
		if player == lockedPlayer then index = i; break end
	end
	if index == 0 then setTarget(list[1]); return end
	local nextIndex = (index % #list) + 1
	setTarget(list[nextIndex])
end

--------------------------------------------------
-- HANDLE TARGET DEATH
--------------------------------------------------

local function handleTargetDeath(player)
	deadPlayers[player] = true
	if player == lockedPlayer then
		removeTargetHighlight()
		if acceptedMode then
			selectNextAcceptedTarget()
		else
			updateTargetDisplay()
		end
	end
	if targetMenu.Visible then refreshTargets() end
end

--------------------------------------------------
-- WATCH PLAYER CHARACTER
--------------------------------------------------

local function watchPlayer(player)

	if player == localPlayer then
		return
	end

	player.CharacterAdded:Connect(function(character)

		--------------------------------------------------
		-- Respawn makes the player eligible again.
		--------------------------------------------------

		deadPlayers[player] = nil

		local humanoid =
			character:WaitForChild(
				"Humanoid",
				5
			)

		if humanoid then

			humanoid.Died:Connect(function()

				handleTargetDeath(player)

			end)

		end

		--------------------------------------------------
		-- Recreate highlight if this is still the
		-- selected player.
		--------------------------------------------------

		if player == lockedPlayer then

			task.defer(function()

				updateTargetHighlight()

			end)

		end

		if targetMenu.Visible then
			refreshTargets()
		end

	end)

	--------------------------------------------------
	-- Handle a character that already exists.
	--------------------------------------------------

	if player.Character then

		local character = player.Character

		local humanoid =
			character:FindFirstChildOfClass(
				"Humanoid"
			)

		if humanoid then

			if humanoid.Health <= 0 then

				deadPlayers[player] = true

			else

				deadPlayers[player] = nil

			end

			humanoid.Died:Connect(function()

				handleTargetDeath(player)

			end)

		end

	end

end

--------------------------------------------------
-- AIM UPDATE
--------------------------------------------------

local function updateLock()

	if not targetLock then
		return
	end

	if not lockedPlayer then

		targetLock = false
		aimButton.Text = "AIM: OFF"

		return
	end

	if lockedPlayer.Parent ~= Players then

		lockedPlayer = nil
		targetLock = false

		removeTargetHighlight()
		updateTargetDisplay()

		aimButton.Text = "AIM: OFF"

		return
	end

	--------------------------------------------------
	-- WAIT FOR THE CURRENT TARGET TO RESPAWN
	--------------------------------------------------

	-- Keep the aimbot enabled while the selected target is dead.
	-- The target remains selected and aiming resumes automatically
	-- when CharacterAdded clears deadPlayers for that player.
	if not isPlayerAlive(lockedPlayer) then
		return
	end

	local character =
		lockedPlayer.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if humanoid
		and humanoid.Health <= 5 then

		if acceptedMode then
			selectNextAcceptedTarget()
		else
			handleTargetDeath(lockedPlayer)
		end
		return
	end

	--------------------------------------------------
	-- UPPER TORSO
	--------------------------------------------------

	local aimPart =
		character:FindFirstChild("UpperTorso")

	if not aimPart then

		aimPart =
			character:FindFirstChild("Torso")

	end

	if not aimPart then
		return
	end

	--------------------------------------------------
	-- AIM POINT
	--
	-- Slightly above the UpperTorso center.
	--------------------------------------------------

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local distance = (camera.CFrame.Position - aimPart.Position).Magnitude
	local verticalOffset = math.clamp(0.5 + (distance / 500), 0.5, 0.85)

	local aimPoint =
		aimPart.Position +
		Vector3.new(0, verticalOffset, 0)

	--------------------------------------------------
	-- CAMERA
	--------------------------------------------------

	camera.CFrame =
		CFrame.lookAt(
			camera.CFrame.Position,
			aimPoint
		)

end

--------------------------------------------------
-- RGB CROSSHAIR + AIM LOOP
--------------------------------------------------

local hue = 0

RunService.RenderStepped:Connect(function(deltaTime)

	hue =
		(hue + deltaTime * 0.5) % 1

	local rainbow =
		Color3.fromHSV(
			hue,
			1,
			1
		)

	horizontal.BackgroundColor3 =
		rainbow

	vertical.BackgroundColor3 =
		rainbow

	if acceptedMode then
		-- Re-evaluate every frame so the target is always the
		-- physically closest eligible accepted player.
		local closest = getClosestAcceptedTarget()

		if closest ~= lockedPlayer then
			if closest then
				setTarget(closest)
			elseif lockedPlayer then
				setTarget(nil)
			end
		end
	end

	if targetLock then
		updateLock()
	end

end)

