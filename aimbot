local function pulsePlayerButton(button, accepted)

	local normalColor

	if accepted then
		normalColor = Color3.fromRGB(35, 105, 55)
	else
		normalColor = Color3.fromRGB(28, 28, 35)
	end

	local lightColor =
		Color3.fromRGB(75, 75, 85)

	local fadeIn = TweenService:Create(
		button,
		TweenInfo.new(
			0.1,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			BackgroundColor3 = lightColor
		}
	)

	local fadeOut = TweenService:Create(
		button,
		TweenInfo.new(
			0.15,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			BackgroundColor3 = normalColor
		}
	)

	fadeIn:Play()

	fadeIn.Completed:Connect(function()

		if button.Parent then
			fadeOut:Play()
		end

	end)
end

