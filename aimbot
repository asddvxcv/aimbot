local function refreshTargets()

	for _, child in ipairs(targetMenu:GetChildren()) do

		if child:IsA("TextButton") then
			child:Destroy()
		end

	end

	for _, targetPlayer in ipairs(Players:GetPlayers()) do

		if targetPlayer ~= localPlayer then

			local isAccepted =
				acceptedPlayers[targetPlayer] == true

			local button = Instance.new("TextButton")
			button.Name = targetPlayer.Name
			button.Size = UDim2.new(1, 0, 0, 50)
			button.Text = ""

			if isAccepted then

				button.BackgroundColor3 =
					Color3.fromRGB(35, 105, 55)

			else

				button.BackgroundColor3 =
					Color3.fromRGB(28, 28, 35)

			end

			button.BorderSizePixel = 0
			button.AutoButtonColor = false
			button.Parent = targetMenu

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 8)
			corner.Parent = button

			--------------------------------------------------
			-- AVATAR
			--------------------------------------------------

			local avatar = Instance.new("ImageLabel")
			avatar.Name = "Avatar"
			avatar.Size = UDim2.fromOffset(40, 40)
			avatar.Position = UDim2.fromOffset(5, 5)
			avatar.BackgroundTransparency = 1
			avatar.Parent = button

			local avatarCorner = Instance.new("UICorner")
			avatarCorner.CornerRadius = UDim.new(1, 0)
			avatarCorner.Parent = avatar

			task.spawn(function()

				local success, image = pcall(function()

					return Players:GetUserThumbnailAsync(
						targetPlayer.UserId,
						Enum.ThumbnailType.HeadShot,
						Enum.ThumbnailSize.Size100x100
					)

				end)

				if success and avatar.Parent then
					avatar.Image = image
				end

			end)

			--------------------------------------------------
			-- PLAYER NAME
			--------------------------------------------------

			local nameLabel = Instance.new("TextLabel")
			nameLabel.Size = UDim2.new(1, -60, 1, 0)
			nameLabel.Position = UDim2.fromOffset(55, 0)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Text = targetPlayer.DisplayName
			nameLabel.TextSize = 15
			nameLabel.Font = Enum.Font.Gotham
			nameLabel.TextColor3 =
				Color3.fromRGB(235, 235, 240)
			nameLabel.TextXAlignment =
				Enum.TextXAlignment.Left
			nameLabel.Parent = button

			--------------------------------------------------
			-- PLAYER SELECT
			--------------------------------------------------

			button.Activated:Connect(function()

				if acceptedMode then

					--------------------------------------------------
					-- ACCEPT / REJECT PLAYER
					--------------------------------------------------

					acceptedPlayers[targetPlayer] =
						not acceptedPlayers[targetPlayer]

					selectClosestAcceptedTarget()

					refreshTargets()

				else

					--------------------------------------------------
					-- MANUAL MODE
					--------------------------------------------------

					setTarget(targetPlayer)

					pulsePlayerButton(
						button,
						false
					)

					task.delay(0.12, function()

						if button.Parent then
							targetMenu.Visible = false
						end

					end)

				end

			end)

		end
	end

	task.defer(function()

		targetMenu.CanvasSize =
			UDim2.fromOffset(
				0,
				layout.AbsoluteContentSize.Y + 20
			)

	end)
end

